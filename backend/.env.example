# Opcional. Sin clave se ejecutan únicamente las heurísticas locales.
GOOGLE_SAFE_BROWSING_API_KEY=

# Desactivado por defecto. Habilita únicamente las URLs controladas de docs/demo.md.
DEMO_MODE=false

# Lista JSON de orígenes permitidos durante el desarrollo local.
CORS_ORIGINS=["http://localhost","http://127.0.0.1"]

